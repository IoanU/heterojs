{
  "name": "heterojs",
  "version": "0.2.0-beta.2",
  "description": "Browser-native CPU and WebGPU computing with static and adaptive scheduling",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/library/types/index.d.ts",
      "import": "./dist/library/index.js"
    }
  },
  "files": [
    "dist/library",
    "docs",
    "examples"
  ],
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:library && npm run build:site",
    "build:library": "vite build --config vite.library.config.ts && tsc -p tsconfig.library.json",
    "build:site": "vite build",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "test:package": "node scripts/verify-package.mjs",
    "benchmark:browser": "node benchmark/run.mjs",
    "benchmark:gpu-graph": "node benchmark/run-gpu-graph.mjs",
    "benchmark:estimate-work": "node benchmark/run-estimate-work.mjs",
    "prepack": "npm run build:library"
  },
  "dependencies": {
    "@webgpu/types": "0.1.74"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
